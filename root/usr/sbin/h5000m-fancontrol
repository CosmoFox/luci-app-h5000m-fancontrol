#!/bin/sh

# Shared helpers (is_uint, clamp, calc_curve_pwm, read_temp_c, fresh_enough,
# modem cache parsers). On the device this lives in /usr/share/h5000m-fancontrol;
# tests point H5000M_FAN_LIB at the repository copy.
LIB="${H5000M_FAN_LIB:-/usr/share/h5000m-fancontrol/lib.sh}"
if [ -r "$LIB" ]; then
	# shellcheck source=root/usr/share/h5000m-fancontrol/lib.sh
	. "$LIB"
else
	echo "h5000m-fancontrol: helper library not found: $LIB" >&2
	exit 1
fi

TAG="h5000m-fancontrol"
STATE_FILE="/var/run/h5000m-fancontrol.state"
POLICY_FILE="/var/run/h5000m-fancontrol.policy"
MAPCACHE="/var/run/h5000m-fancontrol.mapcache"
LOCK_DIR="/var/lock/h5000m-fancontrol.lock"
MT5700M_TEMP_CACHE="${H5000M_FAN_MT5700M_TEMP_CACHE:-/var/run/mt5700m/temperature}"
MT5700M_TEMP_MAX_AGE="${H5000M_FAN_MT5700M_TEMP_MAX_AGE:-300}"
SENSOR_SYSFS_ROOT="${H5000M_FAN_SENSOR_SYSFS_ROOT:-/sys}"
RADIO_SYSFS_ROOT="${H5000M_FAN_RADIO_SYSFS_ROOT:-/sys/class/net}"

# Read the first line of a sysfs-style file into the named variable without
# forking cat; empty string when the file is missing or unreadable.
read_file() { # <var> <file>
	local _v=""
	if [ -r "$2" ]; then
		IFS= read -r _v < "$2" 2>/dev/null || _v="${_v:-}"
	fi
	eval "$1=\"\$_v\""
}

find_pwm() {
	local hwmon pwm name
	for hwmon in /sys/class/hwmon/hwmon*; do
		[ -d "$hwmon" ] || continue
		read_file name "$hwmon/name"
		[ "$name" = "pwmfan" ] || continue
		pwm="$hwmon/pwm1"
		[ -e "$pwm" ] && { echo "$pwm"; return 0; }
	done
	for pwm in /sys/class/hwmon/hwmon*/pwm1; do
		[ -e "$pwm" ] && { echo "$pwm"; return 0; }
	done
	return 1
}

find_fan_rpm() {
	local fan
	for fan in /sys/class/hwmon/hwmon*/fan*_input; do
		[ -e "$fan" ] && { echo "$fan"; return 0; }
	done
	return 1
}

find_thermal_zone() {
	local zone policies type fallback
	fallback=""
	for zone in /sys/class/thermal/thermal_zone*; do
		[ -r "$zone/policy" ] && [ -r "$zone/available_policies" ] || continue
		read_file policies "$zone/available_policies"
		case " $policies " in *" user_space "*) ;; *) continue ;; esac
		[ -n "$fallback" ] || fallback="$zone"
		read_file type "$zone/type"
		case "$(printf '%s' "$type" | tr '[:upper:]' '[:lower:]')" in
			*cpu*|*soc*|*mt798*) echo "$zone"; return 0 ;;
		esac
	done
	[ -n "$fallback" ] && { echo "$fallback"; return 0; }
	return 1
}

take_thermal_control() {
	local zone policy
	zone="$(find_thermal_zone 2>/dev/null || true)"
	[ -n "$zone" ] || {
		# shellcheck disable=SC2034
		CONTROL_ZONE=""
		# shellcheck disable=SC2034
		CONTROL_POLICY=""
		return 0
	}

	# Recover once from releases that changed the complete CPU thermal zone to
	# user_space. The H5000M controller owns PWM output only; the kernel must
	# retain the thermal governor so CPU cooling and critical protection remain
	# active.
	if [ -f "$POLICY_FILE" ]; then
		release_thermal_control
	fi
	read_file policy "$zone/policy"
	[ -n "$policy" ] || return 1
	# shellcheck disable=SC2034
	CONTROL_ZONE="$zone"
	# shellcheck disable=SC2034
	CONTROL_POLICY="$policy"
	return 0
}

release_thermal_control() {
	local zone policy available
	[ -f "$POLICY_FILE" ] || return 0
	zone="$(sed -n '1p' "$POLICY_FILE" 2>/dev/null || true)"
	policy="$(sed -n '2p' "$POLICY_FILE" 2>/dev/null || true)"
	if [ -r "$zone/policy" ]; then
		read_file available "$zone/available_policies"
		case " $available " in
			*" $policy "*) ;;
			*" step_wise "*) policy="step_wise" ;;
			*) policy="" ;;
		esac
		[ -z "$policy" ] || echo "$policy" > "$zone/policy" 2>/dev/null || true
	fi
	rm -f "$POLICY_FILE"
}

# Firmware with the 5gmodem stack (ModemManager + /usr/share/5gmodem, e.g. the
# FM350-GL builds) publishes the modem temperature in per-modem metrics JSON
# ("mtemp") and in stats/port series. Two layouts exist: the older flat /tmp
# files and the newer /tmp/5gmodem/ directory used by current 5gmodem builds;
# both are tried. The files are maintained by that firmware's own 5gmodem
# daemon, so reading them is safe - the AT port is locked by that daemon.
# Sources are tried in order, the hottest fresh value wins.
find_5gmodem_temp() {
	local file v age best have_metrics parsed rest mtemp
	best=""; have_metrics=""
	for file in /tmp/5gmodem_metrics_*.json /tmp/5gmodem/metrics_*.json; do
		[ -f "$file" ] || continue
		have_metrics=1
		parsed="$(parse_5gmodem_metrics "$file" 2>/dev/null || true)"
		case "$parsed" in
			*'|'*'|'*) ;;
			*) continue ;;
		esac
		rest="${parsed#*|}"
		age="${rest%%|*}"
		mtemp="${rest##*|}"
		case "${parsed%%|*}" in
			""|-) continue ;;
		esac
		fresh_enough "$file" "$age" || continue
		v="$(printf '%s' "$mtemp" | grep -Eo -- '-?[0-9][0-9]*([.][0-9]+)?' | head -n 1)"
		[ -n "$v" ] || continue
		v="$(printf '%s' "$v" | sed 's/[.].*//')"
		[ "$v" -ge -40 ] 2>/dev/null && [ "$v" -le 150 ] 2>/dev/null || continue
		if [ -z "$best" ] || [ "$v" -gt "$best" ]; then best="$v"; fi
	done
	[ -n "$best" ] && { echo "$best"; return 0; }
	# Metrics exist but every snapshot reports the modem missing ("modem":"-"):
	# the stock daemon is offline, do not fall back to shrinking stale series.
	[ -n "$have_metrics" ] && return 1
	for file in /tmp/5gmodem_stats/temp.* /tmp/5gmodem/stats/temp.*; do
		case "$file" in *.label) continue ;; esac
		[ -f "$file" ] || continue
		fresh_enough "$file" || continue
		v="$(tail -n 1 "$file" 2>/dev/null | awk '{ print $2 }')"
		case "$v" in ''|*[!0-9-]*) continue ;; esac
		[ "$v" -ge -40 ] 2>/dev/null && [ "$v" -le 150 ] 2>/dev/null || continue
		if [ -z "$best" ] || [ "$v" -gt "$best" ]; then best="$v"; fi
	done
	[ -n "$best" ] && { echo "$best"; return 0; }
	for file in /tmp/5gmodem_temp_* /tmp/5gmodem/temp_*; do
		[ -f "$file" ] || continue
		fresh_enough "$file" || continue
		v="$(awk 'NR == 1 { print $1 }' "$file" 2>/dev/null)"
		v="$(printf '%s' "$v" | grep -Eo -- '-?[0-9][0-9]*([.][0-9]+)?' | head -n 1)"
		[ -n "$v" ] || continue
		v="$(printf '%s' "$v" | sed 's/[.].*//')"
		[ "$v" -ge -40 ] 2>/dev/null && [ "$v" -le 150 ] 2>/dev/null || continue
		if [ -z "$best" ] || [ "$v" -gt "$best" ]; then best="$v"; fi
	done
	[ -n "$best" ] && echo "$best"
}

find_5gmodem_name() {
	local file name have_metrics parsed
	have_metrics=""
	for file in /tmp/5gmodem_metrics_*.json /tmp/5gmodem/metrics_*.json; do
		[ -f "$file" ] || continue
		have_metrics=1
		parsed="$(parse_5gmodem_metrics "$file" 2>/dev/null || true)"
		name="${parsed%%|*}"
		case "$name" in
			""|-) continue ;;
		esac
		printf '%s\n' "$name"
		return 0
	done
	[ -n "$have_metrics" ] && return 1
	for file in /tmp/5gmodem_stats/temp.*.label /tmp/5gmodem/stats/temp.*.label; do
		[ -f "$file" ] || continue
		read_file name "$file"
		[ -n "$name" ] && printf '%s\n' "$name" && return 0
	done
	return 1
}

find_module_temp() {
	local file value updated now age parsed
	if [ -r "$MT5700M_TEMP_CACHE" ] && is_uint "$MT5700M_TEMP_MAX_AGE"; then
		parsed="$(parse_mt5700m_cache "$MT5700M_TEMP_CACHE" 2>/dev/null || true)"
		if [ -n "$parsed" ]; then
			value="${parsed%%|*}"
			updated="${parsed##*|}"
			now="$(date +%s)"
			if is_uint "$updated" && is_uint "$now" && is_uint "$value"; then
				age=$((now - updated))
				if [ "$age" -ge 0 ] && [ "$age" -le "$MT5700M_TEMP_MAX_AGE" ]; then
					echo "$value"
					return 0
				fi
			fi
		fi
	fi
	for file in /tmp/cache_base_info_* /tmp/cache_*info*; do
		[ -f "$file" ] || continue
		value="$(sed -n 's/.*"key"[[:space:]]*:[[:space:]]*"temperature"[^}]*"value"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$file" 2>/dev/null | head -n 1 | grep -Eo -- '-?[0-9]+' | head -n 1)"
		case "$value" in ''|*[!0-9-]*) continue ;; esac
		[ "$value" -ge -40 ] 2>/dev/null && [ "$value" -le 150 ] 2>/dev/null || continue
		echo "$value"
		return 0
	done
	value="$(find_5gmodem_temp 2>/dev/null || true)"
	[ -n "$value" ] && { echo "$value"; return 0; }
	return 1
}

max_sensor() {
	local value="$1" label="$2"
	[ -n "$value" ] || return 0
	if [ -z "${CONTROL_TEMP:-}" ] || [ "$value" -gt "$CONTROL_TEMP" ]; then
		CONTROL_TEMP="$value"
		CONTROL_SENSOR="$label"
	fi
}

read_sensors() {
	local zone type value hwmon name
	CPU_TEMP=""; CPU_LABEL=""; PHY_TEMP=""; PHY_LABEL=""
	WIFI1_TEMP=""; WIFI1_LABEL=""; WIFI2_TEMP=""; WIFI2_LABEL=""
	MODULE_TEMP="$(find_module_temp 2>/dev/null || true)"
	CONTROL_TEMP=""; CONTROL_SENSOR=""

	for zone in "$SENSOR_SYSFS_ROOT"/class/thermal/thermal_zone*; do
		[ -e "$zone/temp" ] || continue
		read_file type "$zone/type"
		value="$(read_temp_c "$zone/temp" 2>/dev/null || true)"
		[ -n "$value" ] || continue
		case "$(printf '%s' "$type" | tr '[:upper:]' '[:lower:]')" in
			*cpu*|*soc*|*mt798*|*thermal*)
				[ -n "$CPU_TEMP" ] || { CPU_TEMP="$value"; CPU_LABEL="$type"; }
				;;
		esac
	done

	for hwmon in "$SENSOR_SYSFS_ROOT"/class/hwmon/hwmon*; do
		[ -d "$hwmon" ] || continue
		read_file name "$hwmon/name"
		value="$(read_temp_c "$hwmon/temp1_input" 2>/dev/null || true)"
		[ -n "$value" ] || continue
		case "$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')" in
			*cpu*|*soc*|*mt798*|*thermal*)
				[ -n "$CPU_TEMP" ] || { CPU_TEMP="$value"; CPU_LABEL="$name"; }
				;;
			*mt791*|*mt799*|*wifi*|*radio*)
				if [ -z "$WIFI1_TEMP" ]; then
					WIFI1_TEMP="$value"; WIFI1_LABEL="$name"
				elif [ -z "$WIFI2_TEMP" ]; then
					WIFI2_TEMP="$value"; WIFI2_LABEL="$name"
				fi
				;;
			*mdio*|*phy*)
				[ -n "$PHY_TEMP" ] || { PHY_TEMP="$value"; PHY_LABEL="$name"; }
				;;
		esac
	done

	# Vendor mt_wifi drivers may expose the radio temperature only via
	# iwpriv. Keep native hwmon readings authoritative; missing/invalid
	# is not zero.
	if [ -z "$WIFI1_TEMP" ]; then
		WIFI1_TEMP="$(read_vendor_radio_temp ra0 2>/dev/null || true)"
		[ -z "$WIFI1_TEMP" ] || WIFI1_LABEL="MTK radio ra0"
	fi
	if [ -z "$WIFI2_TEMP" ]; then
		WIFI2_TEMP="$(read_vendor_radio_temp rai0 2>/dev/null || true)"
		[ -z "$WIFI2_TEMP" ] || WIFI2_LABEL="MTK radio rai0"
	fi

	max_sensor "$CPU_TEMP" "${CPU_LABEL:-CPU}"
	if [ "$TEMP_SOURCE" = "max" ]; then
		max_sensor "$PHY_TEMP" "${PHY_LABEL:-PHY}"
		max_sensor "$WIFI1_TEMP" "${WIFI1_LABEL:-WiFi 1}"
		max_sensor "$WIFI2_TEMP" "${WIFI2_LABEL:-WiFi 2}"
		max_sensor "$MODULE_TEMP" "5G modem"
	fi
}

cooling_device_path() {
	local dev type
	for dev in /sys/class/thermal/cooling_device*; do
		[ -d "$dev" ] || continue
		read_file type "$dev/type"
		[ "$type" = "pwm-fan" ] && { echo "$dev"; return 0; }
	done
	return 1
}

read_be32() {
	local file="$1" skip="${2:-0}" hex value
	hex="$(dd if="$file" bs=4 skip="$skip" count=1 2>/dev/null | hexdump -v -e '1/1 "%02x"')"
	case "$hex" in
		????????) value="$(printf '%d' "0x$hex" 2>/dev/null || true)" ;;
		*) value="" ;;
	esac
	is_uint "$value" || return 1
	echo "$value"
}

cooling_level_for_state() {
	local state="$1" levels value
	levels="$(readlink -f "$(dirname "$PWM_PATH")/device/of_node/cooling-levels" 2>/dev/null || true)"
	[ -f "$levels" ] || levels="/sys/firmware/devicetree/base/pwm-fan/cooling-levels"
	[ -f "$levels" ] || return 1
	value="$(read_be32 "$levels" "$state" 2>/dev/null || true)"
	if ! is_uint "$value" || [ "$value" -gt 255 ]; then
		return 1
	fi
	echo "$value"
}

# Report the kernel emergency floors as map steps when the firmware cooling
# maps are unavailable (patched firmware) or unreadable (minimal busybox).
synthesize_floor_steps() {
	local steps="" threshold state value
	while [ $# -ge 2 ]; do
		threshold="$1"; state="$2"; shift 2
		value="$(cooling_level_for_state "$state" 2>/dev/null || true)"
		is_uint "$value" || continue
		[ -n "$steps" ] && steps="$steps,"
		steps="$steps${threshold}=$value"
	done
	[ -n "$steps" ] && THERMAL_MAP_STEPS="$steps"
}

# Look up a cooling level stored in the map cache (see write_mapcache).
mapcache_level_for_state() { # <state>
	local pair
	for pair in $MAPCACHE_LEVELS; do
		if [ "${pair%%:*}" = "$1" ]; then
			echo "${pair#*:}"
			return 0
		fi
	done
	return 1
}

# Persist the result of the device-tree scan so later iterations - and the
# status query the LuCI page polls every few seconds - can compute the kernel
# floor without dd/hexdump/readlink pipelines. The cache is keyed on the PWM
# node and invalidated by format version; /var/run is cleared on reboot, so a
# changed device tree can never reuse a stale cache.
write_mapcache() { # <owner> <maps csv> <space-separated states>
	local owner="$1" maps="$2"; shift 2
	local tmp="${MAPCACHE}.$$" st lv
	{
		echo "v=1"
		echo "pwm=$PWM_PATH"
		echo "owner=$owner"
		echo "max_state=$THERMAL_MAX_STATE"
		echo "maps=$maps"
		echo "steps=$THERMAL_MAP_STEPS"
		for st in "$@"; do
			is_uint "$st" || continue
			lv="$(cooling_level_for_state "$st" 2>/dev/null || true)"
			is_uint "$lv" || lv=255
			echo "level_${st}=$lv"
		done
	} > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 0; }
	mv "$tmp" "$MAPCACHE" 2>/dev/null || rm -f "$tmp"
}

# Compute THERMAL_* from the cached scan; returns 1 when the cache is absent,
# stale or malformed and the caller must rescan the device tree.
thermal_floor_from_cache() {
	local line key value maps="" owner="" max_state="" steps=""
	local m rest th hy st state level old_ifs
	MAPCACHE_LEVELS=""
	[ -f "$MAPCACHE" ] || return 1
	while IFS='=' read -r key value; do
		case "$key" in
			v) [ "$value" = "1" ] || return 1 ;;
			pwm) [ "$value" = "$PWM_PATH" ] || return 1 ;;
			owner) owner="$value" ;;
			max_state) max_state="$value" ;;
			maps) maps="$value" ;;
			steps) steps="$value" ;;
			level_[0-9]*) MAPCACHE_LEVELS="$MAPCACHE_LEVELS ${key#level_}:${value}" ;;
			*) return 1 ;;
		esac
	done < "$MAPCACHE"
	[ -n "$owner" ] || return 1
	case "$owner" in userspace|shared) ;; *) return 1 ;; esac

	THERMAL_OWNER="$owner"
	[ -n "$max_state" ] && THERMAL_MAX_STATE="$max_state"
	THERMAL_MAP_STEPS="$steps"

	if [ "$owner" = "userspace" ]; then
		if [ -z "$CPU_TEMP" ]; then
			THERMAL_STATE=3
			THERMAL_FLOOR=255
			return 0
		fi
		state=0
		[ "$CPU_TEMP" -ge 83 ] && state=2
		[ "$CPU_TEMP" -ge 113 ] && state=3
	else
		state=0
		old_ifs="$IFS"; IFS=','
		for m in $maps; do
			th="${m%%:*}"; rest="${m#*:}"; hy="${rest%%:*}"; st="${rest##*:}"
			if ! is_uint "$th" || ! is_uint "$hy" || ! is_uint "$st"; then
				IFS="$old_ifs"
				return 1
			fi
			if [ -n "$CPU_TEMP" ] && [ "$CPU_TEMP" -ge $((th - hy)) ] && [ "$st" -gt "$state" ]; then
				state="$st"
			fi
		done
		IFS="$old_ifs"
		[ -n "$CPU_TEMP" ] || { THERMAL_FLOOR=255; return 0; }
		# Conservative fallback for old H5000M firmware if DT discovery fails.
		if [ "$state" -eq 0 ]; then
			[ "$CPU_TEMP" -ge 38 ] && state=1
			[ "$CPU_TEMP" -ge 83 ] && state=2
			[ "$CPU_TEMP" -ge 113 ] && state=3
		fi
	fi
	if [ "$state" -gt 0 ]; then
		level="$(mapcache_level_for_state "$state" 2>/dev/null || true)"
		if is_uint "$level"; then THERMAL_FLOOR="$level"; else THERMAL_FLOOR=255; fi
	fi
	THERMAL_STATE="$state"
	return 0
}

# Full device-tree scan (runs once per boot; later iterations use the cache).
thermal_floor_scan() { # <cooling_device>
	local dev="$1" dt fan_phandle map map_phandle map_state trip_ref trip
	local threshold hyst trip_phandle value maps_examined map_found step_value
	local triples="" triples_sorted="" cache_states st
	dt="$(readlink -f "$(dirname "$PWM_PATH")/device/of_node" 2>/dev/null || true)"
	[ -d "$dt" ] || dt="/sys/firmware/devicetree/base/pwm-fan"
	fan_phandle="$(read_be32 "$dt/phandle" 2>/dev/null || true)"
	maps_examined=0
	map_found=0

	# Derive the required state from the kernel's own cooling maps. Direct PWM
	# writes also change cur_state, so cur_state itself is not a safe floor.
	if is_uint "$fan_phandle"; then
		for map in /sys/firmware/devicetree/base/thermal-zones/*/cooling-maps/*; do
			[ -f "$map/cooling-device" ] && [ -f "$map/trip" ] || continue
			map_phandle="$(read_be32 "$map/cooling-device" 0 2>/dev/null || true)"
			is_uint "$map_phandle" || continue
			maps_examined=1
			[ "$map_phandle" = "$fan_phandle" ] || continue
			map_found=1
			map_state="$(read_be32 "$map/cooling-device" 2 2>/dev/null || true)"
			trip_ref="$(read_be32 "$map/trip" 0 2>/dev/null || true)"
			if ! is_uint "$map_state" || ! is_uint "$trip_ref"; then
				continue
			fi
			for trip in /sys/firmware/devicetree/base/thermal-zones/*/trips/*; do
				[ -f "$trip/phandle" ] && [ -f "$trip/temperature" ] || continue
				trip_phandle="$(read_be32 "$trip/phandle" 0 2>/dev/null || true)"
				[ "$trip_phandle" = "$trip_ref" ] || continue
				threshold="$(read_be32 "$trip/temperature" 0 2>/dev/null || true)"
				hyst="$(read_be32 "$trip/hysteresis" 0 2>/dev/null || echo 0)"
				is_uint "$threshold" || continue
				threshold=$((threshold / 1000)); is_uint "$hyst" || hyst=0; hyst=$((hyst / 1000))
				step_value="$(cooling_level_for_state "$map_state" 2>/dev/null || true)"
				is_uint "$step_value" && MAP_STEP_RAW="$MAP_STEP_RAW ${threshold}=${step_value}"
				if [ -n "$CPU_TEMP" ] && [ "$CPU_TEMP" -ge "$((threshold - hyst))" ] && [ "$map_state" -gt "$THERMAL_STATE" ]; then
					THERMAL_STATE="$map_state"
				fi
				triples="$triples ${threshold}:${hyst}:${map_state}"
			done
		done
	fi
	if [ -n "$MAP_STEP_RAW" ]; then
		# shellcheck disable=SC2086
		THERMAL_MAP_STEPS="$(printf '%s\n' $MAP_STEP_RAW | sort -t= -k1,1n -u | tr '\n' ',')"
		THERMAL_MAP_STEPS="${THERMAL_MAP_STEPS%,}"
	fi
	if [ "$maps_examined" -eq 1 ] && [ "$map_found" -eq 0 ]; then
		THERMAL_OWNER="userspace"
		# The old 40 C active map made useful low-speed control impossible. In
		# exclusive mode retain only the high-temperature emergency floors.
		if [ -z "$CPU_TEMP" ]; then
			THERMAL_STATE=3
			THERMAL_FLOOR=255
		else
			[ "$CPU_TEMP" -ge 83 ] && THERMAL_STATE=2
			[ "$CPU_TEMP" -ge 113 ] && THERMAL_STATE=3
			if [ "$THERMAL_STATE" -gt 0 ]; then
				value="$(cooling_level_for_state "$THERMAL_STATE" 2>/dev/null || true)"
				if is_uint "$value"; then THERMAL_FLOOR="$value"; else THERMAL_FLOOR=255; fi
			fi
		fi
		synthesize_floor_steps 83 2 113 3
		write_mapcache "userspace" "83:0:2,113:0:3" "2 3"
		return 0
	fi
	[ "$map_found" -eq 1 ] && THERMAL_OWNER="shared"
	if [ -n "$triples" ]; then
		# shellcheck disable=SC2086
		triples_sorted="$(printf '%s\n' $triples | sort -t: -k1,1n -k3,3n -u | tr '\n' ',')"
		triples_sorted="${triples_sorted%,}"
		# shellcheck disable=SC2086
		cache_states="$( { printf '%s\n' $triples | cut -d: -f3; printf '1\n2\n3\n'; } | sort -n -u | tr '\n' ' ' )"
		write_mapcache "shared" "$triples_sorted" "$cache_states"
	fi
	[ -n "$CPU_TEMP" ] || { THERMAL_FLOOR=255; return 0; }

	# Conservative fallback for old H5000M firmware if DT discovery fails.
	if [ "$THERMAL_STATE" -eq 0 ]; then
		[ "$CPU_TEMP" -ge 38 ] && THERMAL_STATE=1
		[ "$CPU_TEMP" -ge 83 ] && THERMAL_STATE=2
		[ "$CPU_TEMP" -ge 113 ] && THERMAL_STATE=3
	fi
	[ "$THERMAL_STATE" -gt 0 ] || return 0
	value="$(cooling_level_for_state "$THERMAL_STATE" 2>/dev/null || true)"
	is_uint "$value" && THERMAL_FLOOR="$value" || THERMAL_FLOOR=255
	[ -n "$THERMAL_MAP_STEPS" ] || synthesize_floor_steps 38 1 83 2 113 3
}

set_thermal_floor() {
	local dev
	THERMAL_FLOOR=0
	THERMAL_STATE=0
	THERMAL_MAX_STATE=0
	THERMAL_OWNER="unknown"
	THERMAL_MAP_STEPS=""
	MAP_STEP_RAW=""
	dev="$(cooling_device_path 2>/dev/null || true)"
	[ -n "$dev" ] || return 0
	read_file THERMAL_MAX_STATE "$dev/max_state"
	is_uint "$THERMAL_MAX_STATE" || THERMAL_MAX_STATE=0

	thermal_floor_from_cache && return 0
	thermal_floor_scan "$dev"
}

acquire_lock() {
	local owner
	if mkdir "$LOCK_DIR" 2>/dev/null; then
		echo "$$" > "$LOCK_DIR/pid"
		return 0
	fi
	owner="$(cat "$LOCK_DIR/pid" 2>/dev/null || true)"
	if ! is_uint "$owner" || ! kill -0 "$owner" 2>/dev/null; then
		rm -rf "$LOCK_DIR" 2>/dev/null
		mkdir "$LOCK_DIR" 2>/dev/null || return 1
		echo "$$" > "$LOCK_DIR/pid"
		return 0
	fi
	return 1
}

release_lock() {
	rm -rf "$LOCK_DIR" 2>/dev/null
}

# Load the state written by the previous daemon iteration into PREV_* variables
# with a single file read (no per-key sed/head pipelines).
read_state() {
	local key value
	PREV_RESULT=""; PREV_REASON=""; PREV_REQUESTED_PWM=""; PREV_TARGET_PWM=""
	PREV_APPLIED_PWM=""; PREV_UPDATED=""; PREV_DOWN_SINCE=0
	[ -f "$STATE_FILE" ] || return 0
	while IFS='=' read -r key value; do
		case "$key" in
			result) PREV_RESULT="$value" ;;
			reason) PREV_REASON="$value" ;;
			requested_pwm) PREV_REQUESTED_PWM="$value" ;;
			target_pwm) PREV_TARGET_PWM="$value" ;;
			applied_pwm) PREV_APPLIED_PWM="$value" ;;
			down_since) is_uint "$value" && PREV_DOWN_SINCE="$value" ;;
			updated) PREV_UPDATED="$value" ;;
		esac
	done < "$STATE_FILE"
	return 0
}

write_state() {
	local tmp="${STATE_FILE}.$$"
	{
		echo "updated=$(date +%s)"
		echo "result=$RESULT"
		echo "reason=$REASON"
		echo "requested_pwm=$REQUESTED_PWM"
		echo "target_pwm=$TARGET_PWM"
		echo "applied_pwm=$APPLIED_PWM"
		echo "thermal_floor=$THERMAL_FLOOR"
		echo "thermal_state=$THERMAL_STATE"
		echo "thermal_max_state=$THERMAL_MAX_STATE"
		echo "thermal_owner=$THERMAL_OWNER"
		echo "control_temp=${CONTROL_TEMP:-}"
		echo "control_sensor=${CONTROL_SENSOR:-}"
		echo "down_since=${DOWN_SINCE:-0}"
	} > "$tmp" && mv "$tmp" "$STATE_FILE"
}

# Read the whole configuration in a single uci invocation and sanitize it
# exactly like the previous per-option lookups did.
load_config() {
	local line opt val
	ENABLED=1; MODE="auto"; PROFILE="balanced"; TEMP_SOURCE="max"
	MANUAL_PWM=160; INTERVAL=5; HYSTERESIS=2; DOWN_DELAY=30
	START_PWM=192; START_BOOST_MS=700; FAIL_PWM=255; OVERRIDE_FLOOR=0
	CURVE_SILENT='20:0,35:0,40:20,50:20,60:40,70:50,85:100,95:100'
	CURVE_BALANCED='20:0,35:0,40:50,55:60,70:75,85:90,95:100'
	CURVE_PERFORMANCE='20:0,30:60,45:70,60:82,75:92,85:100'
	CURVE_CUSTOM='20:0,40:50,55:60,70:75,85:90,95:100'

	while IFS= read -r line; do
		case "$line" in
			h5000m_fancontrol.settings.*=*)
				opt="${line#h5000m_fancontrol.settings.}"
				val="${opt#*=}"
				opt="${opt%%=*}"
				case "$val" in "'"*) val="${val#?}" ;; esac
				case "$val" in *"'") val="${val%?}" ;; esac
				case "$opt" in
					enabled) ENABLED="$val" ;;
					mode) MODE="$val" ;;
					curve) PROFILE="$val" ;;
					temp_source) TEMP_SOURCE="$val" ;;
					manual_pwm) MANUAL_PWM="$val" ;;
					interval) INTERVAL="$val" ;;
					hysteresis) HYSTERESIS="$val" ;;
					down_delay) DOWN_DELAY="$val" ;;
					start_pwm) START_PWM="$val" ;;
					start_boost_ms) START_BOOST_MS="$val" ;;
					fail_pwm) FAIL_PWM="$val" ;;
					override_floor) OVERRIDE_FLOOR="$val" ;;
					curve_silent) CURVE_SILENT="$val" ;;
					curve_balanced) CURVE_BALANCED="$val" ;;
					curve_performance) CURVE_PERFORMANCE="$val" ;;
					curve_custom) CURVE_CUSTOM="$val" ;;
				esac
				;;
		esac
	done <<EOF
$(uci -q show h5000m_fancontrol 2>/dev/null || true)
EOF

	is_uint "$ENABLED" || ENABLED=1
	ENABLED="$(clamp "$ENABLED" 0 1)"
	case "$MODE" in auto|manual|kernel) ;; off) MODE="kernel" ;; *) MODE="auto" ;; esac
	case "$PROFILE" in silent|balanced|performance|custom) ;; *) PROFILE="balanced" ;; esac
	case "$TEMP_SOURCE" in max|cpu) ;; *) TEMP_SOURCE="max" ;; esac
	is_uint "$MANUAL_PWM" || MANUAL_PWM=160
	MANUAL_PWM="$(clamp "$MANUAL_PWM" 0 255)"
	is_uint "$INTERVAL" || INTERVAL=5
	INTERVAL="$(clamp "$INTERVAL" 2 60)"
	is_uint "$HYSTERESIS" || HYSTERESIS=2
	HYSTERESIS="$(clamp "$HYSTERESIS" 0 10)"
	is_uint "$DOWN_DELAY" || DOWN_DELAY=30
	DOWN_DELAY="$(clamp "$DOWN_DELAY" 0 300)"
	is_uint "$START_PWM" || START_PWM=192
	START_PWM="$(clamp "$START_PWM" 80 255)"
	is_uint "$START_BOOST_MS" || START_BOOST_MS=700
	START_BOOST_MS="$(clamp "$START_BOOST_MS" 0 3000)"
	is_uint "$FAIL_PWM" || FAIL_PWM=255
	FAIL_PWM="$(clamp "$FAIL_PWM" 192 255)"
	is_uint "$OVERRIDE_FLOOR" || OVERRIDE_FLOOR=0
	OVERRIDE_FLOOR="$(clamp "$OVERRIDE_FLOOR" 0 1)"

	case "$PROFILE" in
		silent) CURVE_DATA="$CURVE_SILENT" ;;
		performance) CURVE_DATA="$CURVE_PERFORMANCE" ;;
		custom) CURVE_DATA="$CURVE_CUSTOM" ;;
		*) CURVE_DATA="$CURVE_BALANCED" ;;
	esac
}

apply_once() {
	local current last_pwm candidate now elapsed sleep_s
	load_config
	read_state
	PWM_PATH="$(find_pwm 2>/dev/null || true)"
	if [ -z "$PWM_PATH" ]; then
		logger -t "$TAG" "PWM control node not found; unable to apply policy"
		return 1
	fi

	read_sensors
	set_thermal_floor
	REQUESTED_PWM=0; REASON="$MODE"; RESULT="ok"; DOWN_SINCE=0

	if [ "$ENABLED" != "1" ] || [ "$MODE" = "kernel" ]; then
		release_thermal_control
		read_file current "$PWM_PATH"
		is_uint "$current" || current=0
		REQUESTED_PWM=0; TARGET_PWM="$current"; APPLIED_PWM="$current"
		REASON="kernel"
		THERMAL_OWNER="kernel"
		write_state
		return 0
	fi

	if ! take_thermal_control; then
		logger -t "$TAG" "unable to inspect kernel thermal policy; cooling policy not changed"
		release_thermal_control
		return 1
	fi
	[ "$THERMAL_OWNER" = "unknown" ] && THERMAL_OWNER="userspace-pwm"

	if [ "$MODE" = "manual" ]; then
		REQUESTED_PWM="$MANUAL_PWM"
		REASON="manual"
	elif [ -z "$CONTROL_TEMP" ]; then
		REQUESTED_PWM="$FAIL_PWM"
		REASON="sensor-failsafe"
		RESULT="failsafe"
	else
		REQUESTED_PWM="$(calc_curve_pwm "$CONTROL_TEMP" "$CURVE_DATA" 2>/dev/null || true)"
		if ! is_uint "$REQUESTED_PWM"; then
			REQUESTED_PWM="$FAIL_PWM"
			REASON="curve-failsafe"
			RESULT="failsafe"
		else
			REASON="auto"
		fi
	fi

	REQUESTED_PWM="$(clamp "$REQUESTED_PWM" 0 255)"
	TARGET_PWM="$REQUESTED_PWM"
	EFFECTIVE_FLOOR="$THERMAL_FLOOR"
	if [ "$OVERRIDE_FLOOR" = "1" ] && [ "$THERMAL_OWNER" = "shared" ] && [ "$RESULT" = "ok" ]; then
		EFFECTIVE_FLOOR=0
		if [ "$THERMAL_FLOOR" -gt "$TARGET_PWM" ]; then
			REASON="${REASON}+floor-override"
			case "$PREV_REASON" in
				*floor-override*) ;;
				*) logger -t "$TAG" "floor override active: firmware floor=$THERMAL_FLOOR pwm=$TARGET_PWM" ;;
			esac
		fi
	fi
	[ "$EFFECTIVE_FLOOR" -gt "$TARGET_PWM" ] && { TARGET_PWM="$EFFECTIVE_FLOOR"; REASON="${REASON}+kernel-floor"; }

	read_file current "$PWM_PATH"
	is_uint "$current" || current=0
	last_pwm="$PREV_APPLIED_PWM"; is_uint "$last_pwm" || last_pwm="$current"
	now="$(date +%s)"

	if [ "$MODE" = "auto" ] && [ "$RESULT" = "ok" ] && [ "$TARGET_PWM" -lt "$last_pwm" ]; then
		candidate="$(calc_curve_pwm "$((CONTROL_TEMP + HYSTERESIS))" "$CURVE_DATA" 2>/dev/null || echo "$TARGET_PWM")"
		is_uint "$candidate" || candidate="$TARGET_PWM"
		[ "$EFFECTIVE_FLOOR" -gt "$candidate" ] && candidate="$EFFECTIVE_FLOOR"
		TARGET_PWM="$candidate"
		DOWN_SINCE="$PREV_DOWN_SINCE"; is_uint "$DOWN_SINCE" || DOWN_SINCE=0
		[ "$DOWN_SINCE" -gt 0 ] || DOWN_SINCE="$now"
		elapsed=$((now - DOWN_SINCE))
		if [ "$elapsed" -lt "$DOWN_DELAY" ]; then
			TARGET_PWM="$last_pwm"
			REASON="auto-down-delay"
		else
			DOWN_SINCE=0
		fi
	fi

	TARGET_PWM="$(clamp "$TARGET_PWM" 0 255)"
	if [ "$current" -eq 0 ] && [ "$TARGET_PWM" -gt 0 ] && [ "$START_BOOST_MS" -gt 0 ]; then
		candidate="$START_PWM"; [ "$TARGET_PWM" -gt "$candidate" ] && candidate="$TARGET_PWM"
		echo "$candidate" > "$PWM_PATH" 2>/dev/null || return 1
		# BusyBox sleep in official snapshots accepts integer seconds only.
		sleep_s=$(((START_BOOST_MS + 999) / 1000))
		sleep "$sleep_s"
	fi

	if [ "$current" -ne "$TARGET_PWM" ]; then
		if ! echo "$TARGET_PWM" > "$PWM_PATH" 2>/dev/null; then
			logger -t "$TAG" "failed to set PWM target=$TARGET_PWM"
			return 1
		fi
	fi
	read_file APPLIED_PWM "$PWM_PATH"
	is_uint "$APPLIED_PWM" || APPLIED_PWM="$TARGET_PWM"
	if [ "$RESULT" != "$PREV_RESULT" ]; then
		if [ "$RESULT" = "failsafe" ]; then
			logger -t "$TAG" "failsafe enabled reason=$REASON pwm=$TARGET_PWM"
		elif [ "$PREV_RESULT" = "failsafe" ]; then
			logger -t "$TAG" "sensor and curve validation recovered; normal control resumed"
		fi
	fi
	write_state
	return 0
}

print_settings() {
	echo "enabled=$ENABLED"
	echo "mode=$MODE"
	echo "curve=$PROFILE"
	echo "curve_data=$CURVE_DATA"
	echo "temp_source=$TEMP_SOURCE"
	echo "manual_pwm=$MANUAL_PWM"
	echo "interval=$INTERVAL"
	echo "hysteresis=$HYSTERESIS"
	echo "down_delay=$DOWN_DELAY"
	echo "start_pwm=$START_PWM"
	echo "start_boost_ms=$START_BOOST_MS"
	echo "override_floor=$OVERRIDE_FLOOR"
}

print_status() {
	local fan now age zone policy current_pwm fan_rpm
	load_config
	read_state
	PWM_PATH="$(find_pwm 2>/dev/null || true)"
	read_sensors
	THERMAL_FLOOR=0; THERMAL_STATE=0; THERMAL_MAX_STATE=0; THERMAL_OWNER="unknown"; THERMAL_MAP_STEPS=""
	[ -n "$PWM_PATH" ] && set_thermal_floor
	zone="$(find_thermal_zone 2>/dev/null || true)"
	policy=""
	[ -n "$zone" ] && read_file policy "$zone/policy"
	if [ "$ENABLED" != "1" ] || [ "$MODE" = "kernel" ]; then
		THERMAL_OWNER="kernel"
	fi
	print_settings
	echo "pwm=${PWM_PATH:-}"
	current_pwm=""
	[ -n "$PWM_PATH" ] && read_file current_pwm "$PWM_PATH"
	echo "pwm_value=$current_pwm"
	fan="$(find_fan_rpm 2>/dev/null || true)"
	echo "fan=${fan:-}"
	if [ -n "$fan" ]; then
		echo "fan_feedback=1"
		fan_rpm=""
		read_file fan_rpm "$fan"
		echo "fan_rpm=$fan_rpm"
	else
		echo "fan_feedback=0"
		echo "fan_rpm="
	fi
	echo "cpu_temp=$CPU_TEMP"; echo "cpu_label=$CPU_LABEL"
	echo "phy_temp=$PHY_TEMP"; echo "phy_label=$PHY_LABEL"
	echo "wifi1_temp=$WIFI1_TEMP"; echo "wifi1_label=$WIFI1_LABEL"
	echo "wifi2_temp=$WIFI2_TEMP"; echo "wifi2_label=$WIFI2_LABEL"
	echo "module_temp=$MODULE_TEMP"; echo "module_label=5G modem"; echo "module_name=$(find_5gmodem_name 2>/dev/null || true)"
	echo "control_temp=$CONTROL_TEMP"; echo "control_sensor=$CONTROL_SENSOR"
	echo "thermal_floor=$THERMAL_FLOOR"
	echo "kernel_floor_levels=${THERMAL_MAP_STEPS:-}"
	echo "thermal_state=$THERMAL_STATE"
	echo "thermal_max_state=$THERMAL_MAX_STATE"
	echo "thermal_owner=$THERMAL_OWNER"
	echo "result=$PREV_RESULT"
	echo "reason=$PREV_REASON"
	echo "requested_pwm=$PREV_REQUESTED_PWM"
	echo "target_pwm=$PREV_TARGET_PWM"
	echo "applied_pwm=$PREV_APPLIED_PWM"
	now="$(date +%s)"
	if [ "$PREV_DOWN_SINCE" -gt 0 ]; then
		down_remaining=$((DOWN_DELAY - (now - PREV_DOWN_SINCE)))
		[ "$down_remaining" -lt 0 ] && down_remaining=0
	else
		down_remaining=""
	fi
	echo "down_remaining=$down_remaining"
	if is_uint "$PREV_UPDATED"; then age=$((now - PREV_UPDATED)); else age=""; fi
	echo "state_age=$age"
}

run_daemon() {
	trap 'exit 0' TERM INT
	trap 'release_lock; release_thermal_control' EXIT
	INTERVAL=5
	while true; do
		if acquire_lock; then
			apply_once
			release_lock
		fi
		sleep "${INTERVAL:-5}" & wait $!
	done
}

case "${1:-apply}" in
	apply)
		if acquire_lock; then
			trap 'release_lock' EXIT
			apply_once
		else
			echo "fan control is busy" >&2
			exit 1
		fi
		;;
	status) print_status ;;
	daemon) run_daemon ;;
	release) release_thermal_control ;;
	*) echo "Usage: $0 {apply|status|daemon|release}"; exit 1 ;;
esac
