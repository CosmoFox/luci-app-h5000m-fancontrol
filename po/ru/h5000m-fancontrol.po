msgstr "Content-Type: text/plain; charset=UTF-8\n"

msgid "Fan Control"
msgstr "Управление вентилятором"

msgid "%s / 255 · %s%%"
msgstr "%s / 255 · %s%%"

msgid "%s °C"
msgstr "%s °C"

msgid "%s · kernel safety floor"
msgstr "%s · защитный минимум ядра"

msgid "5G modem"
msgstr "5G-модем"

msgid "A short boost helps a stopped fan start reliably. Set 0 to disable."
msgstr "Короткий разгон помогает остановленному вентилятору надёжно запуститься. Укажите 0, чтобы отключить."

msgid "Application update"
msgstr "Обновление приложения"

msgid "Applied output"
msgstr "Фактическая скорость"

msgid "Automatic"
msgstr "Автоматический"

msgid "Automatic curve"
msgstr "Автоматическая кривая"

msgid "Automatically balances cooling and noise based on device temperatures."
msgstr "Автоматически балансирует охлаждение и шум по температурам устройства."

msgid "Balanced"
msgstr "Сбалансированный"

msgid "Beta"
msgstr "Бета"

msgid "Beta versions may be unstable and are provided for testing. They are not recommended for daily use."
msgstr "Бета-версии могут быть нестабильны и предназначены для тестирования. Их не рекомендуется использовать повседневно."

msgid "Check for updates"
msgstr "Проверить обновления"

msgid "Checking the latest release…"
msgstr "Проверка последнего релиза…"

msgid "Checking…"
msgstr "Проверка…"

msgid "Choose a cooling profile or set a manual output. Safety limits remain active in every mode."
msgstr "Выберите профиль охлаждения или задайте ручную скорость. Защитные ограничения остаются активными в любом режиме."

msgid "Comma-separated temperature:percent points. The controller interpolates between points."
msgstr "Точки «температура:процент», разделённые запятыми. Контроллер интерполирует между точками."

msgid "Control interval"
msgstr "Интервал управления"

msgid "Control temperature"
msgstr "Температура для управления"

msgid "Cooling management"
msgstr "Управление охлаждением"

msgid "Cooling policy"
msgstr "Политика охлаждения"

msgid "Cooling policy applied successfully."
msgstr "Политика охлаждения успешно применена."

msgid "Cooling profile"
msgstr "Профиль охлаждения"

msgid "CPU"
msgstr "CPU"

msgid "CPU only"
msgstr "Только CPU"

msgid "Could not check for updates"
msgstr "Не удалось проверить обновления"

msgid "Current input: %s"
msgstr "Текущий источник: %s"

msgid "Current version"
msgstr "Текущая версия"

msgid "Curve failsafe"
msgstr "Неисправность кривой"

msgid "Custom"
msgstr "Пользовательский"

msgid "Custom curve"
msgstr "Пользовательская кривая"

msgid "Download and install the latest beta version now?"
msgstr "Скачать и установить последнюю бета-версию прямо сейчас?"

msgid "Download and install the latest version now?"
msgstr "Скачать и установить последнюю версию прямо сейчас?"

msgid "Effective fan policy"
msgstr "Действующая политика вентилятора"

msgid "Enable enhanced controller"
msgstr "Включить улучшенный контроллер"

msgid "Ethernet PHY"
msgstr "PHY Ethernet"

msgid "Failed to apply cooling policy:"
msgstr "Не удалось применить политику охлаждения:"

msgid "Failed to install the update"
msgstr "Не удалось установить обновление"

msgid "Failsafe cooling"
msgstr "Аварийное охлаждение"

msgid "Fan curve"
msgstr "Кривая вентилятора"

msgid "From the local modem cache"
msgstr "Из локального кэша модема"

msgid "Hottest available sensor"
msgstr "Самый горячий доступный датчик"

msgid "Hysteresis window"
msgstr "Окно гистерезиса"

msgid "Kernel protection"
msgstr "Защита ядра"

msgid "Kernel protection only"
msgstr "Только защита ядра"

msgid "Kernel safety floor"
msgstr "Нижний порог защиты ядра"

msgid "Kernel thermal protection is always retained. Requested output may be raised automatically when the kernel requires more cooling."
msgstr "Термозащита ядра сохраняется всегда. Запрошенная скорость может быть автоматически повышена, если ядру требуется больше охлаждения."

msgid "Loading…"
msgstr "Загрузка…"

msgid "Manual"
msgstr "Ручной"

msgid "Manual PWM output"
msgstr "Ручной уровень ШИМ"

msgid "Manual request"
msgstr "Ручной запрос"

msgid "No beta releases found"
msgstr "Бета-релизы не найдены"

msgid "No valid sensor"
msgstr "Нет достоверного датчика"

msgid "Offer beta releases"
msgstr "Предлагать бета-релизы"

msgid "Operating mode"
msgstr "Режим работы"

msgid "Performance"
msgstr "Производительный"

msgid "Policy"
msgstr "Политика"

msgid "Policy reason"
msgstr "Причина политики"

msgid "Prevents repeated speed changes around a curve point."
msgstr "Предотвращает повторяющиеся изменения скорости возле точки кривой."

msgid "Priority"
msgstr "Приоритет"

msgid "Quiet"
msgstr "Тихий"

msgid "Release page"
msgstr "Страница релиза"

msgid "Requested output"
msgstr "Запрошенная скорость"

msgid "Response & safety"
msgstr "Реакция и защита"

msgid "Running normally"
msgstr "Работает штатно"

msgid "Seconds between control decisions. The dashboard refreshes independently."
msgstr "Секунды между решениями контроллера; панель обновляется независимо."

msgid "Sensor failsafe"
msgstr "Неисправность датчика"

msgid "Speed-down delay"
msgstr "Задержка снижения оборотов"

msgid "Startup boost duration"
msgstr "Длительность стартового разгона"

msgid "Startup boost PWM"
msgstr "ШИМ стартового разгона"

msgid "Status delayed"
msgstr "Статус запаздывает"

msgid "Temperature"
msgstr "Температура"

msgid "Temperature hysteresis"
msgstr "Гистерезис температуры"

msgid "Temperatures must increase from 0–150 °C and percentages must be 0–100."
msgstr "Температуры должны возрастать в диапазоне 0–150 °C, проценты — от 0 до 100."

msgid "The fan manager has exclusive fan policy control. Kernel CPU throttling and hot/critical over-temperature protection remain active."
msgstr "Менеджер вентилятора единолично управляет политикой вентилятора. Троттлинг CPU и защита от перегрева hot/critical остаются активными."

msgid "The hottest-sensor option considers CPU, Ethernet PHY, Wi-Fi and the available 5G modem cache."
msgstr "Режим «самый горячий датчик» учитывает CPU, PHY Ethernet, Wi-Fi и доступный кэш температуры 5G-модема."

msgid "The kernel safety floor may raise the effective output above this value."
msgstr "Защитный минимум ядра может поднять фактическую скорость выше этого значения."

msgid "The update is still building on the server. Please wait about 15-20 minutes and try again."
msgstr "Сервер ещё собирает обновление. Подождите примерно 15–20 минут и попробуйте снова."

msgid "Unavailable"
msgstr "Недоступно"

msgid "Update"
msgstr "Обновление"

msgid "Update available"
msgstr "Доступно обновление"

msgid "Update installed. Refreshing…"
msgstr "Обновление установлено. Обновляю страницу…"

msgid "Update is taking too long. Check the connection and try again."
msgstr "Обновление выполняется слишком долго. Проверьте соединение и попробуйте ещё раз."

msgid "Use comma-separated temperature:percent points, for example 35:0,45:50,70:80,90:100."
msgstr "Используйте точки «температура:процент» через запятую, например 35:0,45:50,70:80,90:100."

msgid "Wait this many seconds before lowering fan output; temperature increases are applied immediately."
msgstr "Сколько секунд ждать перед снижением оборотов; повышение температуры применяется немедленно."

msgid "Waiting before speed down"
msgstr "Ожидание перед снижением оборотов"

msgid "When disabled, the fan follows the kernel thermal protection level only."
msgstr "Если отключено, вентилятор следует только уровню термозащиты ядра."

msgid "Wi-Fi radios"
msgstr "Радиомодули Wi-Fi"

msgid "You have the latest beta"
msgstr "У вас установлена последняя бета-версия"

msgid "You have the latest version"
msgstr "У вас установлена последняя версия"

msgid "Ignore firmware fan map"
msgstr "Игнорировать карту вентилятора из прошивки"

msgid "Install beta"
msgstr "Установить бета-версию"

msgid "Install update"
msgstr "Установить обновление"

msgid "Installing the update…"
msgstr "Установка обновления…"

msgid "Advanced. Lets automatic and manual output run below the levels the stock firmware enforces at 40, 85 and 115 °C. The kernel still raises the fan when those trip points are crossed; install patched firmware for full control."
msgstr "Для опытных: позволяет автоматическому и ручному режиму работать ниже уровней, которые штатная прошивка навязывает при 40, 85 и 115 °C. Ядро всё равно поднимет обороты при пересечении этих температурных порогов; для полного контроля установите прошивку с патчем."

msgid "%s · ignoring firmware map"
msgstr "%s · игнорирую карту прошивки"

msgid "Firmware fan map: %s. Install patched firmware for full curve control."
msgstr "Карта прошивки: %s. Установка прошивки с патчем даёт полный контроль над кривой."
